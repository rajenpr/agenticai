# Portkey Configuration (REQUIRED)
# Get your API key from: https://app.portkey.ai/
PORTKEY_API_KEY=your-portkey-api-key-here

# Portkey Virtual Key (OPTIONAL)
# Only needed if you've configured a virtual key in Portkey dashboard for Bedrock routing
# If you have direct Bedrock credentials configured in Portkey, you don't need this
# PORTKEY_VIRTUAL_KEY=your-virtual-key-here

# API Server Configuration
API_BASE_URL=http://localhost:8000

# Model Configuration
# Using Bedrock Claude Opus 4: @bedrock-global/us.anthropic.claude-opus-4-20250514-v1:0
# This is configured in the agent code

# LDAP Configuration (for Web Interface)
LDAP_SERVER=ldaps://adblrhldap.adbldesign.analog.com
LDAP_BASE_DN=ou=Users,ou=global,dc=analog,dc=com

# Web Application Security
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Tesseract OCR (Optional - only needed if tesseract not in PATH)
# TESSERACT_CMD=/usr/bin/tesseract
